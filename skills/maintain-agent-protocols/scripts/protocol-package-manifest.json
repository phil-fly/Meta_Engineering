{
  "schema": "maintain-agent-protocols.protocol-package-manifest.v1",
  "default_package_dir": "ai-agent-workspace/protocols",
  "compat_package_dir": "ai-agent-protocols",
  "templates": [
    {
      "source": "templates/user-protocol.md",
      "target": "templates/user-protocol.md"
    },
    {
      "source": "templates/project-protocol.md",
      "target": "templates/project-protocol.md"
    },
    {
      "source": "templates/route-card.md",
      "target": "templates/route-card.md"
    },
    {
      "source": "templates/frontend-design-system-review-prompt.md",
      "target": "templates/frontend-design-system-review-prompt.md"
    }
  ],
  "conditional_artifacts": [
    {
      "id": "frontend-design-tokens",
      "source": "templates/design-tokens.md",
      "default_target": "ai-agent-workspace/product/design/design-tokens.md",
      "compat_targets": ["docs/03_DESIGN/design-tokens.md"],
      "evidence_keys": ["frontend_implementation"],
      "required_markers": [
        "## 1. 文档状态",
        "## 2. 真值源关系",
        "## 3. Color",
        "## 4. Typography",
        "## 5. Spacing",
        "## 6. Size And Density",
        "## 7. Radius",
        "## 8. Border",
        "## 9. Shadow And Elevation",
        "## 10. Layout And Grid",
        "## 11. Breakpoints And Responsive Behavior",
        "## 12. Z-index And Layering",
        "## 13. Motion",
        "## 14. Icons",
        "## 15. Component Tokens",
        "## 16. Theme And Brand Modes",
        "## 17. Exceptions And Debt",
        "## 18. Maintenance Contract",
        "## 19. Change Log"
      ],
      "incomplete_markers": [
        "初始化状态：待回填",
        "| 项目 | 待回填 |",
        "| 状态 | 待回填 |",
        "| 适用前端 | 待回填 |",
        "| 维护路径 | 待回填 |",
        "| 最近核对日期 | 待回填 |",
        "| 最近核对范围 | 待回填 |",
        "| Color | 待回填 |",
        "| Typography | 待回填 |",
        "| Spacing | 待回填 |",
        "| Radius | 待回填 |",
        "| Border | 待回填 |",
        "| Shadow / Elevation | 待回填 |",
        "| Layout / Grid | 待回填 |",
        "| Breakpoint | 待回填 |",
        "| Size / Density | 待回填 |",
        "| Motion | 待回填 |",
        "| Icon | 待回填 |",
        "| Z-index / Layer | 待回填 |",
        "| Component Token | 待回填 |"
      ]
    }
  ],
  "playbooks": {
    "source": "references/scenarios/playbooks.md",
    "target_dir": "playbooks",
    "sections": {
      "coding": "coding.md",
      "architecture": "architecture.md",
      "enterprise-saas-design": "enterprise-saas-design.md",
      "security-review": "security-review.md",
      "performance-review": "performance-review.md",
      "troubleshooting": "troubleshooting.md",
      "research": "research.md"
    }
  },
  "checks": {
    "source": "references/checks/checklists.md",
    "target_dir": "checks",
    "sections": {
      "maintenance-checklist": "maintenance-checklist.md",
      "security-checklist": "security-checklist.md",
      "frontend-design-system-checklist": "frontend-design-system-checklist.md",
      "frontend-i18n-checklist": "frontend-i18n-checklist.md",
      "frontend-accessibility-checklist": "frontend-accessibility-checklist.md",
      "frontend-testing-checklist": "frontend-testing-checklist.md",
      "frontend-performance-checklist": "frontend-performance-checklist.md",
      "frontend-ui-stability-checklist": "frontend-ui-stability-checklist.md",
      "frontend-enterprise-saas-design-checklist": "frontend-enterprise-saas-design-checklist.md",
      "frontend-component-checklist": "frontend-component-checklist.md",
      "frontend-structure-checklist": "frontend-structure-checklist.md",
      "performance-checklist": "performance-checklist.md"
    }
  },
  "route_rules": [
    {
      "id": "frontend",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/frontend/*.md"],
      "target_prefix": "routes/frontend",
      "evidence_keys": ["frontend_implementation"],
      "always_include": ["index.md", "javascript-typescript.md"]
    },
    {
      "id": "backend-go",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/backend/go.md", "references/engineering/backend/go/*.md"],
      "target_prefix": "routes/backend/go",
      "evidence_keys": ["go"]
    },
    {
      "id": "backend-java",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/backend/java.md", "references/engineering/backend/java/*.md"],
      "target_prefix": "routes/backend/java",
      "evidence_keys": ["java"]
    },
    {
      "id": "backend-rust",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/backend/rust.md", "references/engineering/backend/rust/*.md"],
      "target_prefix": "routes/backend/rust",
      "evidence_keys": ["rust"]
    },
    {
      "id": "backend-python",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/backend/python.md"],
      "target_prefix": "routes/backend/python",
      "evidence_keys": ["python"]
    },
    {
      "id": "core",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/core/*.md"],
      "target_prefix": "routes/core",
      "evidence_keys": ["api", "database", "auth", "logging", "config"]
    },
    {
      "id": "security",
      "status": "条件适用",
      "source_globs": ["references/engineering/security/*.md"],
      "target_prefix": "routes/security",
      "evidence_keys": ["security"],
      "conditional": true
    },
    {
      "id": "performance",
      "status": "条件适用",
      "source_globs": ["references/engineering/performance/*.md"],
      "target_prefix": "routes/performance",
      "evidence_keys": ["performance"],
      "conditional": true
    },
    {
      "id": "platform",
      "status": "项目证据支持",
      "source_globs": ["references/engineering/platform/*.md"],
      "target_prefix": "routes/platform",
      "evidence_keys": ["deployment", "observability", "gateway"]
    },
    {
      "id": "governance",
      "status": "通用治理",
      "source_globs": ["references/engineering/governance/index.md", "references/engineering/governance/evidence-and-scope.md", "references/engineering/governance/agent-governance.md"],
      "target_prefix": "routes/governance",
      "evidence_keys": ["governance"],
      "conditional": true
    }
  ],
  "minimal_playbooks": ["coding", "architecture", "security-review", "troubleshooting", "research"],
  "minimal_checks": ["maintenance-checklist", "security-checklist"],
  "project_checks_by_route": {
    "frontend": [
      "frontend-design-system-checklist",
      "frontend-i18n-checklist",
      "frontend-accessibility-checklist",
      "frontend-testing-checklist",
      "frontend-performance-checklist",
      "frontend-ui-stability-checklist",
      "frontend-enterprise-saas-design-checklist",
      "frontend-component-checklist",
      "frontend-structure-checklist"
    ],
    "performance": ["performance-checklist"]
  }
}
